EVENT_SOURCING_DATABASE_URL=postgresql://demo:demo@localhost:5433/event_sourcing
EVENT_SOURCING_ADMIN_DATABASE_URL=postgresql://demo:demo@localhost:5433/postgres
KURRENTDB_CONNECTION_STRING=kurrentdb://localhost:2113?tls=false

# postgres | kurrentdb -- selects which EventStore implementation the Nest
# module binds to EVENT_STORE. Same domain/application code either way.
EVENT_STORE=postgres

# How many events between snapshots. 0 disables snapshotting entirely.
SNAPSHOT_EVERY=5
