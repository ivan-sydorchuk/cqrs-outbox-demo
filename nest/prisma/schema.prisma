// Deliberately hand-written to match sql/schema.sql exactly, rather than
// generated via `prisma migrate`. The tables already exist (created once by
// sql/init-databases.sql against the outbox_nest database) — this schema only
// maps onto them, so there is no migration history for Prisma to own here and
// no chance of Prisma's own DDL drifting from the canonical shared shape.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("OUTBOX_NEST_DATABASE_URL")
}

model Order {
  orderId    String   @id @map("order_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  amount     Decimal  @db.Decimal(12, 2)
  status     String
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("orders")
}

model Outbox {
  position    BigInt   @id @default(autoincrement())
  aggregateId String   @map("aggregate_id") @db.Uuid
  eventType   String   @map("event_type")
  payload     Json
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  // xid8 has no Prisma scalar equivalent, so this is Unsupported: Prisma Client
  // can select it (as a string) but can't filter/order by it or write it through
  // the normal API. The DB-level DEFAULT pg_current_xact_id() (see
  // sql/block10-worker-extension.sql) means ordinary Prisma inserts still get a
  // correct value for free. The worker's polling query reads/compares it via
  // $queryRaw — see worker/outbox-reader.ts.
  transactionId Unsupported("xid8") @map("transaction_id")

  @@map("outbox")
}

// Block 10: one row per logical consumer of the outbox ("subscription"). The
// worker claims this row with SELECT ... FOR UPDATE SKIP LOCKED before
// reading a batch, and advances the checkpoint columns after Kafka acks —
// never before. See worker/outbox-reader.ts.
model EventSubscription {
  name               String              @id
  lastTransactionId  Unsupported("xid8") @map("last_transaction_id")
  lastPosition       BigInt              @default(0) @map("last_position")

  @@map("event_subscription")
}
