// Deliberately hand-written to match sql/schema.sql exactly, rather than
// generated via `prisma migrate`. The tables already exist (created once by
// sql/init-databases.sql against the outbox_nest database) — this schema only
// maps onto them, so there is no migration history for Prisma to own here and
// no chance of Prisma's own DDL drifting from the canonical shared shape.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("OUTBOX_NEST_DATABASE_URL")
}

model Order {
  orderId    String   @id @map("order_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  amount     Decimal  @db.Decimal(12, 2)
  status     String
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("orders")
}

model Outbox {
  position    BigInt   @id @default(autoincrement())
  aggregateId String   @map("aggregate_id") @db.Uuid
  eventType   String   @map("event_type")
  payload     Json
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@map("outbox")
}
